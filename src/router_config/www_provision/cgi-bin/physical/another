    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .card {
    background: #ffffff;
    border-radius: 16px;
    padding: 40px;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    text-align: center;
  }
  h1 { color: #dc2626; margin-bottom: 15px; font-size: 24px; }
  p { color: #374151; line-height: 1.6; margin-bottom: 20px; }
  .button {
    display: inline-block;
    padding: 12px 24px;
    background: #dc2626;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
  }
  .button:hover { background: #b91c1c; }
</style>
</head>
<body>
  <div class="card">
    <h1>❌ $error_title</h1>
    <p>$error_message</p>
EOF

    if [ "$show_retry" = "true" ]; then
        echo '<a href="/" class="button">Try Again</a>'
    fi

    cat << EOF
  </div>
</body>
</html>
EOF
    exit 1
}

# =============================================================================
# VALIDATION FUNCTIONS
# =============================================================================

validate_environment() {
    log_msg "Validating environment..."

    # Check if already configured
    if [ -f "$FLAG_FILE" ]; then
        send_error_page "Already Configured" \
            "This router has already been provisioned. Factory reset is required to re-configure." \
            "false"
    fi

    # Check for native crypt support
    if ! command -v openssl >/dev/null 2>&1 && ! command -v mkpasswd >/dev/null 2>&1; then
        log_error "No cryptographic utilities found"
        send_error_page "System Error" "The router lacks native SHA-512 support. Update firmware."
    fi

    log_msg "Environment validation passed (Native Hashing Enabled)"
}

validate_credentials() {
    local username="$1"
    local password="$2"

    log_msg "Validating credentials..."

    # Username validation
    if [ ${#username} -lt 3 ]; then
        send_error_page "Invalid Username" \
            "Username must be at least 3 characters long."
    fi

    if [ ${#username} -gt 32 ]; then
        send_error_page "Invalid Username" \
            "Username must not exceed 32 characters."
    fi

    if ! echo "$username" | grep -qE '^[a-zA-Z0-9_-]+$'; then
        send_error_page "Invalid Username" \
            "Username can only contain letters, numbers, hyphens, and underscores."
    fi

    # Password validation
    if [ ${#password} -lt 12 ]; then
        send_error_page "Weak Password" \
            "Password must be at least 12 characters long."
    fi

    if [ ${#password} -gt 128 ]; then
        send_error_page "Invalid Password" \
            "Password must not exceed 128 characters."
    fi

    # Check character complexity
    local has_lower=$(echo "$password" | grep -q '[a-z]' && echo 1 || echo 0)
    local has_upper=$(echo "$password" | grep -q '[A-Z]' && echo 1 || echo 0)
    local has_digit=$(echo "$password" | grep -q '[0-9]' && echo 1 || echo 0)
    local has_special=$(echo "$password" | grep -q '[^a-zA-Z0-9]' && echo 1 || echo 0)

    local complexity=$((has_lower + has_upper + has_digit + has_special))

    if [ $complexity -lt 3 ]; then
        send_error_page "Weak Password" \
            "Password must contain at least 3 of: lowercase letters, uppercase letters, digits, special characters."
    fi

    log_msg "Credential validation passed (username: $username, complexity: $complexity/4)"
}

# =============================================================================
# CORE FUNCTIONS
# =============================================================================

hash_password() {
    local password="$1"
    local hash_result=""

    log_msg "Generating SHA-512 hash using native system utilities..."

    if command -v openssl >/dev/null 2>&1; then
        hash_result=$(openssl passwd -6 "$password")
    elif command -v mkpasswd >/dev/null 2>&1; then
        hash_result=$(mkpasswd -m sha-512 "$password")
    else
        log_error "No native hashing utility (openssl/mkpasswd) found."
        send_error_page "System Error" "Native security utilities missing. Contact Support."
    fi

    if [ $? -ne 0 ] || [ -z "$hash_result" ]; then
        log_error "Native hashing failed"
        send_error_page "Cryptographic Error" "Could not generate native hash."
    fi

    log_msg "SHA-512 hash generated successfully"
    echo "$hash_result"
}

save_credentials() {
    local username="$1"
    local hash="$2"
    local password="$3"

    log_msg "Saving credentials to secure storage..."

    if [ "$DRY_RUN" = "false" ]; then
        echo "$username:$hash" > "$CRED_FILE"
        chmod 600 "$CRED_FILE"
        chown root:root "$CRED_FILE"

        # Set system root password (fallback for SSH)
        echo -e "$password\n$password" | passwd root >/dev/null 2>&1

        if [ $? -eq 0 ]; then
            log_msg "Credentials saved successfully"
        else
            log_warning "Failed to update system root password"
        fi
    else
        log_msg "[DRY-RUN] Would save credentials: $username:$hash"
    fi
}

detect_switch_architecture() {
    if [ -d "/sys/class/net/lan1" ] || [ -d "/sys/class/net/lan4" ]; then
        echo "dsa"
    elif [ -f "/sys/class/net/eth0/device/switch0/ports" ] || \
         [ -d "/sys/class/net/eth0.1" ] || \
         [ -d "/sys/class/net/eth0.2" ]; then
        echo "swconfig"
    else
        echo "vm"
    fi
}

configure_management_network() {
    log_msg "Configuring management VLAN..."

    local arch=$(detect_switch_architecture)
    log_msg "Detected architecture: $arch"

    if [ "$DRY_RUN" = "false" ]; then
        case "$arch" in
            swconfig)
                log_msg "swconfig detected: Configuring switch VLAN $MGMT_VLAN_ID"

                # Create switch VLAN entry for VLAN 99
                # Port 4 = LAN4 (untagged), Port 0 = CPU (tagged)
                uci add network switch_vlan
                uci set network.@switch_vlan[-1].device='switch0'
                uci set network.@switch_vlan[-1].vlan="$MGMT_VLAN_ID"
                uci set network.@switch_vlan[-1].ports="$MGMT_SWITCH_PORT 0t"
                
                log_msg "Switch VLAN $MGMT_VLAN_ID configured (Port $MGMT_SWITCH_PORT untagged, Port 0 CPU tagged)"

                mgmt_device="eth0.$MGMT_VLAN_ID"
                ;;

            dsa)
                log_msg "DSA detected: Using physical port isolation"
                
                uci del_list network.@device[0].ports="lan$MGMT_SWITCH_PORT" 2>/dev/null
                uci set network.device_mgmt=device
                uci set network.device_mgmt.name='br-mgmt'
                uci set network.device_mgmt.type='bridge'
                uci add_list network.device_mgmt.ports="lan$MGMT_SWITCH_PORT"

                mgmt_device='br-mgmt'
                ;;

            vm)
                log_msg "VM/Virtual environment detected"
                
                if [ -d "/sys/class/net/eth1" ]; then
                    mgmt_device="eth1.$MGMT_VLAN_ID"
                else
                    mgmt_device="eth0.$MGMT_VLAN_ID"
                fi
                ;;

            *)
                log_error "Unknown architecture detected"
                mgmt_device="eth0.$MGMT_VLAN_ID"
                log_warning "Falling back to eth0.$MGMT_VLAN_ID"
                ;;
        esac

        # Create management interface
        log_msg "Creating management interface on $mgmt_device..."
        uci set network.mgmt=interface
        uci set network.mgmt.proto='static'
        uci set network.mgmt.device="$mgmt_device"
        uci set network.mgmt.ipaddr="$MGMT_IP"
        uci set network.mgmt.netmask="$MGMT_NETMASK"

        # Configure DHCP server for management VLAN
        log_msg "Configuring DHCP for management VLAN..."
        uci set dhcp.mgmt=dhcp
        uci set dhcp.mgmt.interface='mgmt'
        uci set dhcp.mgmt.start="$MGMT_DHCP_START"
        uci set dhcp.mgmt.limit="$MGMT_DHCP_LIMIT"
        uci set dhcp.mgmt.leasetime="$MGMT_DHCP_LEASE"
        
        log_msg "DHCP configured (Range: 192.168.99.$MGMT_DHCP_START-$((MGMT_DHCP_START + MGMT_DHCP_LIMIT - 1)))"

        # Disable WiFi radios (keep disabled post-setup)
        log_msg "Disabling WiFi radios..."
        uci set wireless.default_radio0.disabled='1'
        uci set wireless.default_radio1.disabled='1'

        # Add to firewall LAN zone
        log_msg "Adding management interface to firewall..."
        uci add_list firewall.@zone[0].network='mgmt'

        # Remove DNS hijacking
        log_msg "Removing DNS hijacking..."
        uci del_list dhcp.@dnsmasq[0].address='/#/192.168.2.1' 2>/dev/null

        # Reconfigure web server to ONLY listen on management IP
        log_msg "Reconfiguring web server to management IP only..."
        uci delete uhttpd.main.listen_http 2>/dev/null
        uci delete uhttpd.main.listen_https 2>/dev/null
        uci add_list uhttpd.main.listen_http="$MGMT_IP:80"
        uci set uhttpd.main.home='/www'

        # Commit all changes
        log_msg "Committing configuration..."
        uci commit network
        uci commit dhcp
        uci commit wireless
        uci commit firewall
        uci commit uhttpd

        log_msg "Management network configured successfully on $mgmt_device"

    else
        log_msg "[DRY-RUN] Architecture: $arch"
        log_msg "[DRY-RUN] Would configure switch VLAN $MGMT_VLAN_ID on port $MGMT_SWITCH_PORT"
        log_msg "[DRY-RUN] Would configure management on eth0.$MGMT_VLAN_ID"
        log_msg "[DRY-RUN] Would set management IP: $MGMT_IP"
        log_msg "[DRY-RUN] Would configure DHCP range: $MGMT_IP.$MGMT_DHCP_START-$((MGMT_DHCP_START + MGMT_DHCP_LIMIT - 1))"
    fi
}

create_completion_flag() {
    log_msg "Creating completion flag..."

    if [ "$DRY_RUN" = "false" ]; then
        touch "$FLAG_FILE"
        chmod 444 "$FLAG_FILE"
        chown root:root "$FLAG_FILE"
        log_msg "Completion flag created: $FLAG_FILE"
    else
        log_msg "[DRY-RUN] Would create flag: $FLAG_FILE"
    fi
}

apply_changes() {
    log_msg "Applying network changes..."

    if [ "$DRY_RUN" = "false" ]; then
        (
            sleep 2
            
            log_msg "Restarting network..."
            /etc/init.d/network restart 2>&1 | tee -a "$LOG_FILE"
            
            sleep 3
            
            log_msg "Bringing up management interface..."
            ifup mgmt 2>&1 | tee -a "$LOG_FILE"
            
            sleep 2
            
            log_msg "Restarting DHCP server..."
            /etc/init.d/dnsmasq restart 2>&1 | tee -a "$LOG_FILE"
            
            sleep 1
            
            log_msg "Restarting web server..."
            /etc/init.d/uhttpd restart 2>&1 | tee -a "$LOG_FILE"
            
            sleep 1
            
            log_msg "Reloading WiFi..."
            wifi reload 2>&1 | tee -a "$LOG_FILE"

            log_msg "Configuration applied successfully"
        ) &
    else
        log_msg "[DRY-RUN] Would apply network changes in background"
    fi
}

